{
  "version": 1,
  "ui": [
    "client/src/components/**",
    "client/src/pages/**",
    "client/src/styles/**",
    "client/src/index.css",
    "client/src/assets/**",
    "client/public/**",
    "docs/design/**"
  ],
  "frozen": [
    "server/**",
    "shared/**",
    "api/**",
    "migrations/**",
    "script/**",
    "client/src/App.tsx",
    "client/src/main.tsx",
    "client/src/lib/**",
    "client/src/hooks/**",
    "drizzle.config.*",
    "vercel.json",
    "package.json",
    "package-lock.json",
    ".env*",
    ".github/**"
  ],
  "protected": [
    "design/guard.json",
    "design/landmarks*.lock.json",
    "docs/design/landmarks*.lock.json",
    "tests/landmarks*"
  ],
  "variants": [
    "client/src/**/__variants__/**"
  ]
}
